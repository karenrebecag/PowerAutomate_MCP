{
  "name": "power-automate-mcp",
  "version": "0.1.0",
  "description": "Local stdio MCP server for personal Power Automate cloud flows — reverse-engineered over the undocumented api.flow.microsoft.com service API, authenticated with your own account (no admin, no paid quota).",
  "type": "module",
  "bin": {
    "power-automate-mcp": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "login": "tsx src/auth/login.ts",
    "check": "tsc --noEmit",
    "lint": "eslint src/",
    "format": "prettier --write 'src/**/*.ts' 'scripts/**/*.ts'",
    "format:check": "prettier --check 'src/**/*.ts' 'scripts/**/*.ts'",
    "test": "vitest run",
    "probe": "tsx scripts/probe-endpoints.ts",
    "verify": "pnpm check && pnpm lint && pnpm format:check && pnpm test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^22.0.0",
    "eslint": "^9.0.0",
    "prettier": "^3.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.2.6"
  }
}
